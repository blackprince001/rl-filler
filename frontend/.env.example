# WebSocket URL for the Flood-It backend.
# Local dev: ws://localhost:8000/ws/game
# Production: wss://your-railway-service.up.railway.app/ws/game
VITE_WS_URL=ws://localhost:8000/ws/game

# HTTP base URL for the same backend (cookies, /games, /stats, /session).
# If unset, derived from VITE_WS_URL (ws→http, wss→https, /ws/game stripped).
VITE_API_URL=http://localhost:8000
